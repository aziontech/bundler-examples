{
  "name": "supabase-with-openai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run embeddings && next build --no-lint",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "embeddings": "tsx lib/generate-embeddings.ts",
    "embeddings:refresh": "tsx lib/generate-embeddings.ts --refresh"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf",
    "sqlKeywordCase": "lower"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@supabase/supabase-js": "^2.110.8",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ai": "^7.0.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "common-tags": "^1.8.2",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "github-slugger": "^2.0.0",
    "gpt3-tokenizer": "^1.1.5",
    "lucide-react": "^1.27.0",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "next": "16.2.12",
    "openai": "^6.49.0",
    "openai-edge": "^1.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "unist-builder": "^4.0.0",
    "unist-util-filter": "^5.0.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@aziontech/opennextjs-azion": "1.1.2",
    "@types/common-tags": "^1.8.4",
    "@types/estree": "^1.0.9",
    "@types/mdast": "^4.0.4",
    "@types/yargs": "^17.0.35",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1"
  }
}
